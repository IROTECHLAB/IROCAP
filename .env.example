# ---------------------------------------------------------------------------
# irocap environment variables
# ---------------------------------------------------------------------------

# NeonDB serverless Postgres connection string (pooled).
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# JWT secret for the tokens issued after a successful solve.
IROCAP_JWT_SECRET="generate-48-random-bytes-hex"

# JWT secret for admin sessions. MUST be different from IROCAP_JWT_SECRET.
IROCAP_ADMIN_JWT_SECRET="generate-48-random-bytes-hex"

# NEW: HMAC secret for signing challenges. Prevents tampering and lets
# /api/verify reject forged challenges without a DB lookup.
IROCAP_CHALLENGE_SECRET="generate-48-random-bytes-hex"

# Cron secret (also used to hit /api/cleanup from external cron).
CRON_SECRET="generate-32-random-bytes-hex"

# Public base URL.
IROCAP_BASE_URL="https://irocap.vercel.app"

# Optional: admin credentials for CLI scripts.
IROCAP_ADMIN_EMAIL=""
IROCAP_ADMIN_PASSWORD=""
