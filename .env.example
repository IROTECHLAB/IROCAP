# ============================================================================
# irocap environment variables
# ============================================================================
# Copy to `.env` for local development, and add the same variables in the
# Vercel dashboard (or via `vercel env add`) for production/preview/development.
# ============================================================================


# ----------------------------------------------------------------------------
# DATABASE_URL — REQUIRED
# ----------------------------------------------------------------------------
# NeonDB serverless Postgres connection string.
#
# Get it from: https://console.neon.tech → your project → Connection Details
# Use the "Pooled connection" string — the hostname contains `-pooler`.
#
# Format:
#   postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
#
# NOTE: if your URL ends with `&channel_binding=require`, remove that parameter.
# The Neon HTTP driver does not support SCRAM channel binding and will fail
# with an opaque connection error.
DATABASE_URL="postgresql://neondb_owner:password@ep-xxx-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"


# ----------------------------------------------------------------------------
# IROCAP_JWT_SECRET — REQUIRED
# ----------------------------------------------------------------------------
# Signing key for the short-lived (5 min) tokens issued after a successful
# PoW solve. HS256. Minimum 32 bytes.
#
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
IROCAP_JWT_SECRET="replace-with-48-random-bytes-hex"


# ----------------------------------------------------------------------------
# IROCAP_ADMIN_JWT_SECRET — REQUIRED
# ----------------------------------------------------------------------------
# Signing key for admin session tokens (12h TTL) used by /admin.html.
# MUST be different from IROCAP_JWT_SECRET — compromise of one must not
# grant access to the other.
#
# Generate the same way.
IROCAP_ADMIN_JWT_SECRET="replace-with-a-different-48-random-bytes-hex"


# ----------------------------------------------------------------------------
# IROCAP_CHALLENGE_SECRET — REQUIRED
# ----------------------------------------------------------------------------
# HMAC key used to sign challenges issued by /api/challenge. The client echoes
# the signature back on /api/verify, where it's validated BEFORE any DB hit —
# this rejects forged or tampered challenges cheaply.
#
# MUST be different from the two JWT secrets above.
#
# Generate the same way.
IROCAP_CHALLENGE_SECRET="replace-with-yet-another-48-random-bytes-hex"


# ----------------------------------------------------------------------------
# CRON_SECRET — REQUIRED
# ----------------------------------------------------------------------------
# Bearer token protecting GET /api/cleanup. Vercel Cron sends this
# automatically if configured, otherwise hit the endpoint from an external
# scheduler (cron-job.org, UptimeRobot, GitHub Actions) with:
#   Authorization: Bearer <CRON_SECRET>
#
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="replace-with-32-random-bytes-hex"


# ----------------------------------------------------------------------------
# IPINFO_TOKEN — OPTIONAL
# ----------------------------------------------------------------------------
# Token for ipinfo.io (free tier: 50,000 lookups/month) used to detect
# datacenter ASNs (AWS, GCP, Azure, Hetzner, etc.). Requests from cloud
# infrastructure are capped at score 0.15.
#
# Sign up: https://ipinfo.io/signup
#
# If unset, ASN-based blocking is disabled and the ASN lookup gracefully
# returns null. All other layers keep working.
IPINFO_TOKEN=""


# ----------------------------------------------------------------------------
# IROCAP_BASE_URL — OPTIONAL (recommended in production)
# ----------------------------------------------------------------------------
# Public base URL of your deployment. Used by:
#   - scripts/e2e.ts (to target the correct host)
#   - scripts/register-site.ts when talking to a remote deployment
#
# No trailing slash.
IROCAP_BASE_URL="https://irocap.vercel.app"


# ----------------------------------------------------------------------------
# IROCAP_ADMIN_EMAIL / IROCAP_ADMIN_PASSWORD — OPTIONAL
# ----------------------------------------------------------------------------
# Convenience for CLI scripts (create-admin.ts, register-site.ts, e2e.ts).
# Not read by any Vercel function — leave unset in production.
#
# To create the first admin user non-interactively:
#   IROCAP_ADMIN_EMAIL=admin@example.com \
#   IROCAP_ADMIN_PASSWORD='a-strong-password' \
#   pnpm tsx scripts/create-admin.ts
IROCAP_ADMIN_EMAIL=""
IROCAP_ADMIN_PASSWORD=""
